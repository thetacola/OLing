	<sonorancy>
		<!-- left == more sonorous, right == less -->
		<son-feature>
			<feature>syllabic</feature>
			<left type="pos">
				<son-feature>
					<feature>low</feature>
					<left type="pos">
						<!-- low vowels -->
					</left>
					<right>
						<son-feature>
							<feature>high</feature>
							<left type="neg">
								<!-- mid vowels -->
							</left>
							<right>
								<!-- high vowels -->
							</right>
						</son-feature>
					</right>
				</son-feature>
			</left>
			<right>
				<son-feature>
					<feature>sonorant</feature>
					<left type="pos">
						<son-feature>
							<feature>nasal</feature>
							<left type="neg">
								<son-feature>
									<feature>lateral</feature>
									<left type="neg">
										<son-feature>
											<feature>vocalic</feature>
											<left type="pos">
												<!-- glides -->
											</left>
											<right>
												<!-- flaps -->
											</right>
										</son-feature>
									</left>
									<right>
										<!-- lateral glides -->
									</right>
								</son-feature>
							</left>
							<right>
								<!-- nasals -->
							</right>
						</son-feature>
					</left>
					<right>
						<son-feature>
							<feature>continuant</feature>
							<left type="pos">
								<son-feature>
									<feature>voice</feature>
									<left type="pos">
										<!-- voiced fricatives -->
									</left>
									<right>
										<!-- voiceless fricatives -->
									</right>
								</son-feature>
							</left>
							<right>
								<son-feature>
									<feature>delayedrelease</feature>
									<left type="pos">
										<son-feature>
											<feature>voice</feature>
											<left type="pos">
												<!-- voiced affricates -->
											</left>
											<right>
												<!-- voiceless affricates -->
											</right>
										</son-feature>
									</left>
									<right>
										<son-feature>
											<feature>voice</feature>
											<left type="pos">
												<!-- voiced stops -->
											</left>
											<right>
												<!-- voiceless stops -->
											</right>
										</son-feature>
									</right>
								</son-feature>
							</right>
						</son-feature>
					</right>
				</son-feature>
			</right>
		</son-feature>
	</sonorancy>
